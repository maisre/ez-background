# Server
PORT=3002

# Database
DATABASE_URL=mongodb://root:root@127.0.0.1:27017/ez?authSource=admin

# AWS SQS
AWS_REGION=us-east-1
# Set AWS_ENDPOINT_URL (e.g. http://localhost:4566) to point SQS + S3 at
# LocalStack; leave it unset for real AWS.
# AWS_ENDPOINT_URL=http://localhost:4566
SQS_SCREENSHOT_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789/ez-screenshot-queue
SQS_EMAIL_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789/ez-email-queue
RESEND_API_KEY=re_your_resend_api_key_here

# Screenshot / dashboard-thumbnail job (screenshot consumer + cron scanner)
# Bucket rendered thumbnails are written to, and its public base URL.
ASSETS_BUCKET=ez-snippet-assets
# ASSETS_CDN_URL=https://assets.ez-snippets.com
# ez-view base URL the headless browser renders pages from.
VIEW_URL=http://localhost:3100
# Trailing-edge debounce + lease (ms). A doc must be quiet this long before a
# capture; a claimed-but-unfinished job re-enqueues after the lease.
# SCREENSHOT_DEBOUNCE_MS=240000
# SCREENSHOT_LEASE_MS=600000
# Page is rendered at SCREENSHOT_WIDTH x SCREENSHOT_HEIGHT (desktop layout),
# then downscaled to SCREENSHOT_THUMB_WIDTH and encoded WebP before upload so
# each card thumbnail is ~30-40 KB instead of multi-MB. 16:10 matches the
# dashboard .thumb box.
# SCREENSHOT_WIDTH=1280
# SCREENSHOT_HEIGHT=800
# SCREENSHOT_THUMB_WIDTH=800
# SCREENSHOT_WEBP_QUALITY=80

# Sentry error reporting
# DSN can stay set permanently — in development, reporting stays OFF until you
# set SENTRY_ENABLE_DEV=true. Staging/prod set SENTRY_ENVIRONMENT via the deploy
# and report whenever a DSN is present.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# SENTRY_ENABLE_DEV=true
